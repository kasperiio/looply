# CARTO basemap API key (free: https://carto.com/basemaps/apikey).
# Without it the map still loads but tiles carry an "API KEY REQUIRED" watermark.
# Local dev: copy this file to .env.local and fill in the key.
# Docker: pass as a build arg (VITE_* vars are inlined by Vite at build time).
VITE_CARTO_KEY=
